@techReport{Shrestha2012,
   abstract = {The availability of satellite-based rainfall products provides an opportunity of estimating rainfall in areas of sparse network density in mountain regions for water resources application. This paper presents the evaluation of the accuracy of satellite-based rainfall estimates in the Khudi Basin (147 km 2) a tributary of the Marshyangdi River in Nepal. Gauge observed rainfall was compared with the National Oceanic and Atmospheric Administration (NOAA) Climate Prediction Centre's CPC_RFE2.0 estimates and Tropical Rainfall Measuring Mission (TRMM) Multisatellite Precipitation Analysis (TMPA) product TRMM 3B42 V 7 for a period of 2002 to 2007. Both the products are found to underestimate precipitation exhibiting a large negative bias. With the CPC_RFE2.0 estimates the correlation was 0.50, the percentage error 45.1%, daily bias-7.2 mm and POD 0.83. With the TRMM estimates the correlation was 0.44, PE 47.3%, daily bias-7.1 mm and POD 0.76. For the same period the annual error statistics using CPC_RFE2.0 for the whole of Nepal is better, with a correlation of 0.72, daily bias of-1.7 mm, multiplicative bias of 0.63, and POD 0.80. The increase in the bias and the drop in the correlation at catchment scale indicate the drop in performance for finer scale applications in mountainous catchments.},
   author = {Mandira S Shrestha and Sagar R Bajracharya and Aseem Sharma},
   title = {P 2.15: Accuracy of satellite-based rainfall estimates in small mountainous catchments: A case of Khudi Khola},
   url = {www.icimod.org},
   year = {2012}
}
